# Ready-to-use defaults — copy to .env.production and deploy.
# Change these before exposing to the internet.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=keystone_dev
POSTGRES_DB=keystone
DATABASE_URL=postgresql://app:keystone_dev@postgres:5432/keystone?connection_limit=25&pool_timeout=30

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=keystone-access-secret-change-before-going-live
JWT_REFRESH_SECRET=keystone-refresh-secret-change-before-going-live
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Device password encryption ───────────────────────────────────────────────
# Decodes to exactly 32 bytes (required for AES-256). Do not shorten.
DEVICE_SECRET_KEY=base64:a2V5c3RvbmUtZGVmYXVsdC1zZWNyZXQta2V5LWhlcmU=

# ─── Object storage (MinIO) ───────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=keystone-faces
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── Ports ────────────────────────────────────────────────────────────────────
API_PORT=4001
RECEIVER_PORT=4002
DASHBOARD_PORT=3002

# ─── Sync engine ──────────────────────────────────────────────────────────────
SYNC_CONCURRENCY=10
SYNC_MAX_RETRIES=8
SYNC_BACKOFF_MS=5000
DEVICE_REQUEST_TIMEOUT_MS=10000
