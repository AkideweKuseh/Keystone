# Copy this to .env.production and fill in every value before deploying.
# Never commit .env.production to git.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=keystone

# Service-to-service URL (uses Docker service name "postgres", not localhost)
DATABASE_URL=postgresql://app:CHANGE_ME_STRONG_PASSWORD@postgres:5432/keystone?connection_limit=25&pool_timeout=30

# ─── Redis ───────────────────────────────────────────────────────────────────
# Service-to-service URL (Docker service name "redis")
REDIS_URL=redis://redis:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_HEX
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_BYTE_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Device password encryption ───────────────────────────────────────────────
# Must be base64-encoded, minimum 32 bytes of entropy.
# Generate with: openssl rand -base64 32
DEVICE_SECRET_KEY=base64:CHANGE_ME_BASE64_32_BYTES

# ─── Object storage (MinIO) ──────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=keystone-faces
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY

# ─── Ports (change if host ports conflict) ───────────────────────────────────
API_PORT=4001
RECEIVER_PORT=4002
DASHBOARD_PORT=3002

# ─── Sync engine tuning ───────────────────────────────────────────────────────
SYNC_CONCURRENCY=10
SYNC_MAX_RETRIES=8
SYNC_BACKOFF_MS=5000
DEVICE_REQUEST_TIMEOUT_MS=10000
