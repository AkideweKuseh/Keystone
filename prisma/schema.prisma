// Smart Access Middleware Platform — PostgreSQL schema
// Connection URL is in prisma.config.ts (Prisma 7+ requirement).
// See docs/03-database-schema.md for full design rationale.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenants ────────────────────────────────────────────────────────────────

model Tenant {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String        @unique
  status         String        @default("active")
  gracePeriodDays Int         @default(0) @map("grace_period_days")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  sites          Site[]
  devices      Device[]
  adminUsers   AdminUser[]
  auditLogs    AuditLog[]
  users        User[]
  accessGroups AccessGroup[]
  accessEvents AccessEvent[]
  integrations Integration[]

  @@map("tenants")
}

// ─── Sites ──────────────────────────────────────────────────────────────────

model Site {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  timezone  String   @default("UTC")
  address   String?
  vpnSubnet String?  @map("vpn_subnet")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  devices   Device[]

  @@index([tenantId])
  @@map("sites")
}

// ─── Devices ────────────────────────────────────────────────────────────────

model Device {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  siteId             String?           @map("site_id") @db.Uuid
  name               String
  vendor             String            @default("hikvision")
  model              String?
  serialNumber       String?           @map("serial_number")
  firmwareVersion    String?           @map("firmware_version")
  ipAddress          String            @map("ip_address")
  port               Int               @default(80)
  username           String
  passwordEncrypted  Bytes             @map("password_encrypted")
  status             String            @default("unknown")
  lastSeenAt         DateTime?         @map("last_seen_at")
  lastHealthCheck    DateTime?         @map("last_health_check")
  pushToken          String?           @map("push_token")
  pushTokenExpiresAt DateTime?         @map("push_token_expires_at")
  eventMode          String            @default("push") @map("event_mode")
  metadata           Json              @default("{}") @db.JsonB
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  site               Site?             @relation(fields: [siteId], references: [id])
  capabilities       DeviceCapability?
  doors              Door[]
  deviceUserSyncs    DeviceUserSync[]

  @@unique([tenantId, ipAddress, port])
  @@index([tenantId, siteId])
  @@index([status])
  @@map("devices")
}

model DeviceCapability {
  deviceId     String   @id @map("device_id") @db.Uuid
  supportsJson Boolean  @default(false) @map("supports_json")
  supportsFace Boolean  @default(false) @map("supports_face")
  supportsFp   Boolean  @default(false) @map("supports_fp")
  maxUsers     Int?     @map("max_users")
  maxCards     Int?     @map("max_cards")
  raw          Json     @default("{}") @db.JsonB
  discoveredAt DateTime @default(now()) @map("discovered_at")
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_capabilities")
}

// ─── Admin users & auth ─────────────────────────────────────────────────────

model AdminUser {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          String
  mfaSecret     String?        @map("mfa_secret")
  isActive      Boolean        @default(true) @map("is_active")
  failedLogins  Int            @default(0) @map("failed_logins")
  lockedUntil   DateTime?      @map("locked_until")
  createdAt     DateTime       @default(now()) @map("created_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@map("admin_users")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("refresh_tokens")
}

// ─── Audit log ──────────────────────────────────────────────────────────────

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorKind String   @map("actor_kind")
  action    String
  resource  String
  payload   Json     @default("{}") @db.JsonB
  result    String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_log")
}

// ─── Users (access-control end-users, not admins) ───────────────────────────

model User {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  employeeNo   String            @map("employee_no")
  firstName    String?           @map("first_name")
  lastName     String?           @map("last_name")
  email        String?
  phone        String?
  status       String            @default("active")
  validFrom    DateTime?         @map("valid_from")
  validTo      DateTime?         @map("valid_to")
  revision     Int               @default(0)
  metadata     Json              @default("{}") @db.JsonB
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  credentials  UserCredential[]
  deviceSyncs  DeviceUserSync[]
  accessGroups UserAccessGroup[]
  fingerprints UserFingerprint[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId, status])
  @@map("users")
}

model UserCredential {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  type         String
  cardNumber   String?  @map("card_number")
  pinHash      String?  @map("pin_hash")
  faceImageKey String?  @map("face_image_key")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, cardNumber])
  @@index([userId])
  @@map("user_credentials")
}

// ─── Access groups & doors ───────────────────────────────────────────────────

model Door {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId   String            @map("device_id") @db.Uuid
  doorIndex  Int               @map("door_index")
  name       String
  openState  String            @default("closed") @map("open_state")
  device     Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  groupDoors AccessGroupDoor[]

  @@unique([deviceId, doorIndex])
  @@map("doors")
}

model AccessGroup {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  name      String
  schedule  Json              @default("{}") @db.JsonB
  createdAt DateTime          @default(now()) @map("created_at")
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  doors     AccessGroupDoor[]
  users     UserAccessGroup[]

  @@index([tenantId])
  @@map("access_groups")
}

model AccessGroupDoor {
  accessGroupId String      @map("access_group_id") @db.Uuid
  doorId        String      @map("door_id") @db.Uuid
  accessGroup   AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)
  door          Door        @relation(fields: [doorId], references: [id], onDelete: Cascade)

  @@id([accessGroupId, doorId])
  @@map("access_group_doors")
}

model UserAccessGroup {
  userId        String      @map("user_id") @db.Uuid
  accessGroupId String      @map("access_group_id") @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessGroup   AccessGroup @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)

  @@id([userId, accessGroupId])
  @@map("user_access_groups")
}

// ─── Device-user sync state machine ─────────────────────────────────────────

model DeviceUserSync {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId      String    @map("device_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  desiredState  String    @map("desired_state")
  currentState  String    @default("unknown") @map("current_state")
  syncStatus    String    @default("pending") @map("sync_status")
  revision      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  lastSyncedAt  DateTime? @map("last_synced_at")
  retryCount    Int       @default(0) @map("retry_count")
  errorMessage  String?   @map("error_message")
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceId, userId])
  @@index([syncStatus])
  @@map("device_user_sync")
}

// ─── Access events ───────────────────────────────────────────────────────────

model AccessEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  deviceId     String?  @map("device_id") @db.Uuid
  doorId       String?  @map("door_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  employeeNo   String?  @map("employee_no")
  eventType    String   @default("unprocessed") @map("event_type")
  eventSubtype String?  @map("event_subtype")
  eventTime    DateTime @default(now()) @map("event_time")
  rawPayload   Json     @map("raw_payload") @db.JsonB
  receivedAt   DateTime @default(now()) @map("received_at")
  dedupKey     String?  @unique @map("dedup_key")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, eventTime(sort: Desc)])
  @@index([deviceId, eventTime(sort: Desc)])
  @@map("access_events")
}

// ─── Gym integration: biometric credentials, outbound webhooks ───────────────

model UserFingerprint {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fingerIndex Int      @map("finger_index")
  algorithm   String   @default("unknown")
  template    Bytes    @map("template")
  checksum    String?
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerIndex])
  @@index([userId])
  @@map("user_fingerprints")
}

model Integration {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  type       String
  name       String   @default("Gym")
  webhookUrl String?  @map("webhook_url")
  verifyKey  String?  @map("verify_key")  // integration's Ed25519 public key (verifies inbound)
  signingKid String?  @map("signing_kid") // Keystone keypair id used to sign outbound
  config     Json     @default("{}") @db.JsonB
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  deliveries WebhookDelivery[]

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("integrations")
}

model WebhookDelivery {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  integrationId String      @map("integration_id") @db.Uuid
  eventId       String?     @map("event_id") @db.Uuid
  payload       Json        @db.JsonB
  status        String      @default("pending") // pending | delivered | failed | dead
  attempts      Int         @default(0)
  maxAttempts   Int         @default(8) @map("max_attempts")
  lastResponse  String?     @map("last_response")
  lastAttemptAt DateTime?   @map("last_attempt_at")
  nextRetryAt   DateTime?   @map("next_retry_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([integrationId])
  @@map("webhook_deliveries")
}
