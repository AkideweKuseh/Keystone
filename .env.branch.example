# ─────────────────────────────────────────────────────────────────────────────
# Per-branch Keystone config. Copy to `.env.branch` on the branch PC and fill in.
# The launcher (infra/launcher) reads this file. One file = one branch.
#
#   ⚠️  Change every secret below before a real deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Branch identity ──────────────────────────────────────────────────────────
# Stable id for THIS branch. Must match the branch/club id in the gym platform,
# so polled members and written attendance are attributed correctly.
BRANCH_ID=branch-001
BRANCH_NAME=Main Street

# ─── PostgreSQL (Keystone's own DB — local to this branch box) ─────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=keystone
DATABASE_URL=postgresql://app:CHANGE_ME_strong_password@postgres:5432/keystone?connection_limit=25&pool_timeout=30

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Device password encryption (base64 → exactly 32 bytes for AES-256) ────────
DEVICE_SECRET_KEY=base64:a2V5c3RvbmUtZGVmYXVsdC1zZWNyZXQta2V5LWhlcmU=

# ─── Object storage (MinIO) ───────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_BUCKET=keystone-faces
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_minio_password

# ─── Host ports (what the branch PC exposes on localhost) ──────────────────────
API_PORT=4001
RECEIVER_PORT=4002
DASHBOARD_PORT=3002

# ─── Sync engine ──────────────────────────────────────────────────────────────
SYNC_CONCURRENCY=10
SYNC_MAX_RETRIES=8
SYNC_BACKOFF_MS=5000
DEVICE_REQUEST_TIMEOUT_MS=10000

# ─── Gym platform integration (BoldGym access API) ────────────────────────────
# Keystone polls membership and reports attendance over BoldGym's HTTP API — it
# does NOT touch the gym database directly. Set the base URL + shared API key to
# enable the poller and attendance sink; leave blank/placeholder to disable them.
GYM_API_URL=https://gym.example.com
GYM_API_KEY=CHANGE_ME_shared_access_key
GYM_POLL_INTERVAL_SEC=60
