# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
RUN npm install -g pnpm@9

# Copy all workspace package manifests so pnpm resolves the full workspace graph
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json       apps/api/
COPY apps/worker/package.json    apps/worker/
COPY apps/receiver/package.json  apps/receiver/
COPY apps/dashboard/package.json apps/dashboard/
COPY libs/domain/package.json        libs/domain/
COPY libs/shared/package.json        libs/shared/
COPY libs/auth/package.json          libs/auth/
COPY libs/queue/package.json         libs/queue/
COPY libs/persistence/package.json   libs/persistence/
COPY libs/audit/package.json         libs/audit/
COPY libs/drivers/core/package.json      libs/drivers/core/
COPY libs/drivers/hikvision/package.json libs/drivers/hikvision/
COPY libs/drivers/mock/package.json      libs/drivers/mock/

# Install ALL deps — devDeps are required for TypeScript compilation
RUN pnpm install --frozen-lockfile

# Copy source
COPY tsconfig.base.json ./
COPY prisma ./prisma
COPY libs ./libs
COPY apps/api ./apps/api

# Generate Prisma client first — persistence lib needs the types to compile
RUN DATABASE_URL=postgresql://u:p@localhost:5432/db pnpm prisma generate

# Build libs in dependency order, then the API
RUN pnpm --filter @sam/domain build \
 && pnpm --filter @sam/shared build \
 && pnpm --filter @sam/auth build \
 && pnpm --filter @sam/queue build \
 && pnpm --filter @sam/persistence build \
 && pnpm --filter @sam/audit build \
 && pnpm --filter @sam/drivers-core build \
 && pnpm --filter @sam/drivers-hikvision build \
 && pnpm --filter @sam/drivers-mock build \
 && pnpm --filter @sam/api build

# Create standalone deployment: workspace deps become real dirs, not symlinks
RUN pnpm deploy --filter @sam/api --prod /deploy/api
# pnpm deploy excludes dist/ because it's in .gitignore — copy it explicitly
RUN cp -r apps/api/dist /deploy/api/dist

# Generate Prisma engine binary inside the deploy (pnpm deploy doesn't copy
# the engine from the virtual store — re-generating from there is cleaner)
RUN cp -r prisma /deploy/api/prisma \
 && cd /deploy/api \
 && DATABASE_URL=postgresql://u:p@localhost:5432/db /app/node_modules/.bin/prisma generate \
 && rm -rf prisma

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache openssl
COPY --from=build /deploy/api .
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "dist/main.js"]
