# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
RUN npm install -g pnpm@9

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json       apps/api/
COPY apps/worker/package.json    apps/worker/
COPY apps/receiver/package.json  apps/receiver/
COPY apps/dashboard/package.json apps/dashboard/
COPY libs/domain/package.json        libs/domain/
COPY libs/shared/package.json        libs/shared/
COPY libs/auth/package.json          libs/auth/
COPY libs/queue/package.json         libs/queue/
COPY libs/persistence/package.json   libs/persistence/
COPY libs/audit/package.json         libs/audit/
COPY libs/drivers/core/package.json      libs/drivers/core/
COPY libs/drivers/hikvision/package.json libs/drivers/hikvision/
COPY libs/drivers/mock/package.json      libs/drivers/mock/

RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY prisma ./prisma
COPY libs ./libs
COPY apps/receiver ./apps/receiver

RUN DATABASE_URL=postgresql://u:p@localhost:5432/db pnpm prisma generate

RUN pnpm --filter @sam/domain build \
 && pnpm --filter @sam/shared build \
 && pnpm --filter @sam/auth build \
 && pnpm --filter @sam/queue build \
 && pnpm --filter @sam/persistence build \
 && pnpm --filter @sam/drivers-core build \
 && pnpm --filter @sam/drivers-hikvision build \
 && pnpm --filter @sam/drivers-mock build \
 && pnpm --filter @sam/receiver build

RUN for d in libs/domain libs/shared libs/auth libs/queue libs/persistence \
             libs/audit libs/drivers/core libs/drivers/hikvision libs/drivers/mock; do \
      : > $d/.npmignore; \
      node -e "const f='$d/package.json',p=require(f);p.main='dist/index.js';require('fs').writeFileSync(f,JSON.stringify(p,null,2))"; \
    done

RUN pnpm deploy --filter @sam/receiver --prod /deploy/receiver
RUN cp -r apps/receiver/dist /deploy/receiver/dist

RUN cp -r prisma /deploy/receiver/prisma \
 && cd /deploy/receiver \
 && DATABASE_URL=postgresql://u:p@localhost:5432/db /app/node_modules/.bin/prisma generate \
 && rm -rf prisma

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache openssl
COPY --from=build /deploy/receiver .
ENV NODE_ENV=production
EXPOSE 3001
CMD ["node", "dist/apps/receiver/src/main.js"]
